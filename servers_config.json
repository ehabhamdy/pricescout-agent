{
    "mcpServers": {
        "puppeteer": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-puppeteer"
            ]
        },
        "sqlite": {
            "command": "uvx",
            "args": [
                "mcp-server-sqlite",
                "--db-path",
                "./sqlite.db"
            ]
        },
        "firecrawl": {
            "command": "uv",
            "args": [
                "run",
                "firecrawl_server.py"
            ]
        }
    }
}